# Every value here is optional: the game runs without an environment file, because the title it
# talks to is baked into src/idos.title.ts. Copy this file to .env.local only when local
# development needs one of them. Read by src/env.ts.

# iDos Games title
VITE_IDOS_TITLE_ID=
VITE_IDOS_BUILD_KEY=

# WalletConnect (Reown) project id for the wallet panel
VITE_WALLETCONNECT_PROJECT_ID=

# Google Identity client id — empty hides the Google sign-in button
VITE_IDOS_GOOGLE_CLIENT_ID=

# Client code ships to players: never put a private key, a token or any other secret here.
